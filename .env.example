# ─── Supabase ────────────────────────────────────────────────────────────────
# Public project URL and anon key. Safe to expose: RLS grants the anon role
# read-only access and there are no write policies at all.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Service role key. NEVER prefix with NEXT_PUBLIC_ — it bypasses RLS and is the
# only key allowed to write. Used exclusively inside server actions.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Optional local setup tools for release 2 (not needed by the deployed app).
# BotFather mini app → bot → Login Widget → Redirect URLs must include:
# https://<project-ref>.supabase.co/auth/v1/callback
# Then: npm run auth:telegram:setup && npm run auth:telegram:check
SUPABASE_ACCESS_TOKEN=""
TELEGRAM_CLIENT_ID=""
TELEGRAM_CLIENT_SECRET=""

# ─── Admin auth ──────────────────────────────────────────────────────────────
# Shared organiser password, stored as a scrypt hash. Generate with:
#   npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH="scrypt$<salt>$<hash>"

# Secret used to sign the admin session cookie (HMAC-SHA256).
# Generate with: npm run secret
AUTH_SECRET="<64-hex-chars>"

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical origin, used for metadata and the Auth callback. Local check:
# http://localhost:3000 (open the app using this exact origin).
NEXT_PUBLIC_SITE_URL="https://g4z-cup.ru"

# Optional overrides for the existing official G4Z CUP community links.
# These are shown independently of tournament-specific links.
NEXT_PUBLIC_COMMUNITY_TELEGRAM_URL=""
NEXT_PUBLIC_COMMUNITY_STREAM_URL=""
